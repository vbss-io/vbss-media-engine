# Chaves das vozes de nuvem (opcional: a voz local funciona sem este arquivo).
# Copie este arquivo para .env (na mesma pasta: content-engine/audio/.env) e troque os valores entre <>.
# Linha cujo valor ainda esta entre <> e ignorada.
# O .env e ignorado pelo git: nunca suba chave, nunca cole chave em conversa ou em chat de assistente.
# Use as chaves do seu proprio recurso de nuvem.
AZURE_SPEECH_KEY=<chave do seu recurso Azure AI Speech>
AZURE_SPEECH_REGION=<regiao>
# Formato do endpoint: https://<recurso>.services.ai.azure.com
AZURE_OPENAI_ENDPOINT=<endpoint do seu recurso Azure OpenAI>
AZURE_OPENAI_KEY=<chave do seu recurso Azure OpenAI>
GOOGLE_TTS_API_KEY=<chave do Google Cloud Text-to-Speech>

# Voz padrao: para trocar, mude aqui (vale na proxima geracao). Ids em: python content-engine/audio/voz.py --listar-vozes
# Sem estas linhas vale o content-engine/audio/voz_config.json (kokoro, voz pf_dora).
VOZ_PROVEDOR=kokoro
VOZ_KOKORO=pf_dora
VOZ_VOICESTUDIO=<nome da sua voz em voicestudio/vozes>
